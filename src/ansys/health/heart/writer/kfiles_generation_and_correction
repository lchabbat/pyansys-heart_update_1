    # Rotation 1 in the frontal plane (FP) : ZX plane in ls-dyna, rotation around Y axis
    axis_FP = np.array([0,1,0])  # Y axis
    rot_FP = R.from_rotvec( np.radians(angle_frontal_plane) * axis_FP)
