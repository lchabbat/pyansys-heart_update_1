def merge_surfaces(surf1: SurfaceMesh, surf2: SurfaceMesh, keep="first") -> SurfaceMesh:

    merged = surf1.merge(surf2, merge_points=True, tolerance=1e-8)
    new_surf = SurfaceMesh(merged)
    new_surf.nodes = np.array(new_surf.points)
    faces = np.reshape(new_surf.faces, (new_surf.n_cells, 4))[:, 1:]
    new_surf.triangles = faces
    if keep == "first":
        new_surf.id = surf1.id
        new_surf.name = surf1.name
    else:
        new_surf.id = surf2.id
        new_surf.name = surf2.name
    return new_surf

def transpose_electrodes( angle1 : int, angle2= int):

    electrodes = np.array([
        [-24, 1331, 114],
        [24, 1331, 114],
        [52, 1299, 125],
        [81, 1280, 116],
        [129, 1279, 86],
        [150, 1294, 46],
        [-84, 1456, 28],
        [84, 1456, 28],
        [-80, 1150, 34],
        [80, 1150, 34]
    ])

    Hans_apex = np.array([65, 1265, 72])
    Hans_mitral = np.array([28,1310,-1.5])
    Hans_tricuspide = np.array([-10,1305,35])
    Hans_V_pulm = np.array([25, 1353, 22])

    Rodero_apex = np.array([108,15,12])
    Rodero_tricuspide = np.array([42,49,47])
    Rodero_mitral  = np.array([78,78,62])
    Rodero_V_pulm = np.array([73, 42, 105])

    P_Hans=np.array([Hans_apex, Hans_tricuspide, Hans_mitral,  Hans_V_pulm])
    P_Model= np.array([Rodero_apex, Rodero_tricuspide, Rodero_mitral, Rodero_V_pulm])

    AR, TR, MR, RP = Rodero_apex, Rodero_tricuspide, Rodero_mitral, Rodero_V_pulm

    #Translation    
    T = P_Model[0] - P_Hans[0]
    P_Hans_T = P_Hans + T

    #R1
    AH, TH, MH = P_Hans_T[0], P_Hans_T[1], P_Hans_T[2]
    VT_Hans = TH - AH
    VT_Model = TR - AR 
    normal_R1 = np.cross(VT_Model, VT_Hans)
    angle_deg_R1 = np.degrees(-np.arccos(np.dot(VT_Hans, VT_Model) / (np.linalg.norm(VT_Model) * np.linalg.norm(VT_Hans))))+angle1      
    axis_R1 = normal_R1 / np.linalg.norm(normal_R1)
    rot_R1 = R.from_rotvec( np.radians(angle_deg_R1) * axis_R1)
    P_Hans_R1 = rot_R1.apply(P_Hans_T - AR) + AR

    #R2
    AH, TH, MH = P_Hans_R1[0], P_Hans_R1[1], P_Hans_R1[2]
    VM_Hans = MH - TH
    VM_Model = MR - TR
    normal_R2 = TH - AH
    angle_deg_R2 = -np.degrees(np.arccos(np.dot(VM_Hans, VM_Model) / (np.linalg.norm(VM_Hans) * np.linalg.norm(VM_Model))))+angle2
    axis_R2 = normal_R2 / np.linalg.norm(normal_R2)
    rot_R2 = R.from_rotvec(np.radians(angle_deg_R2) * axis_R2)
    P_Hans_R2 = rot_R2.apply(P_Hans_R1 - TR) + TR

    AH, TH, MH = P_Hans_R2[0], P_Hans_R2[1], P_Hans_R2[2]

    electrodes_T= electrodes + T
    electrodes_R1 = rot_R1.apply(electrodes_T - AR) + AR
    electrodes_R2 = rot_R2.apply(electrodes_R1 - TR) + TR

    electrodes_align = electrodes_R2

    return electrodes_align




