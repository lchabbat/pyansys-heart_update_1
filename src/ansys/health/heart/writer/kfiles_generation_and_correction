def extract_his_nodes_from_beam(beam_path: str):
    """
    Extract all node ids from ELEMENT_BEAM in PART His_top in beam_networks.k
    Return a sorted list of these nodes (without duplicates).
    """
    his_nodes = set()
    with open(beam_path, "r") as f:
        lines = f.readlines()

    n = len(lines)
    i = 0
    while i < n:
        line = lines[i]
        # locates keyword *PART
        if line.strip().startswith("*PART"):
            # lookahead: skip empty lines and comment lines ($# ...)
            j = i + 1
            while j < n and (lines[j].strip() == "" or lines[j].lstrip().startswith("$#")):
                j += 1
            if j < n and lines[j].strip() == "His_top":
                # scan until the next *PART (or EOF)
                k = j + 1
                in_element = False
                while k < n and not lines[k].strip().startswith("*PART"):
                    s = lines[k].strip()
                    # added condition: if line starts with "$$" → stop everything
                    if s.startswith("$$"):
                        print("⚠️ Stop : line starting with '$$' encountered.")
                        return sorted(his_nodes)

                    # detection of the ELEMENT_BEAM header
                    if s.startswith("*ELEMENT_BEAM"):
                        in_element = True
                        k += 1
                        continue

                    if in_element:
                        # ignore comments and empty lines
                        if not s or s.lstrip().startswith("$#"):
                            k += 1
                            continue
                        tokens = s.split()
                        # check that the line starts with an integer (eid)
                        if tokens and tokens[0].lstrip("-").isdigit():
                            if len(tokens) >= 4:
                                try:
                                    n1 = int(tokens[2])
                                    n2 = int(tokens[3])
                                    his_nodes.update((n1, n2))
                                except ValueError:
                                    pass
                    k += 1
                break
            else:
                i = j
        i += 1

    return sorted(his_nodes)


def update_stim_nodes(parent_folder: str):
    """
    Replaces only the Stim nodes lines in ep_settings.k with the His_top nodes.
    Keeps all other information (sid, da1, etc.).
    Creates a backup ep_settings.k.bak before overwriting.
    """
    ep_path = os.path.join(parent_folder, "ep_settings.k")
    beam_path = os.path.join(parent_folder, "beam_networks.k")

    # files check
    if not os.path.exists(ep_path):
        print(f"❌ Missing file: {ep_path}")
        return False
    if not os.path.exists(beam_path):
        print(f"❌ Missing file: {beam_path}")
        return False

    # Extract His_top nodes
    his_nodes = extract_his_nodes_from_beam(beam_path)
    if not his_nodes:
        print("❌ No His_top nodes found.")
        return False

    # Backup before overwriting
    backup_path = ep_path + ".bak"
    shutil.copyfile(ep_path, backup_path)
    print(f"💾 Backup copy created: {backup_path}")

    # Read ep_settings.k
    with open(ep_path, "r") as f:
        ep_lines = f.readlines()

    new_lines = []
    in_nodes_section = False

    for line in ep_lines:
        stripped = line.strip()

        # Start of the Stim nodes section
        if stripped.startswith("$#   nodes"):
            new_lines.append(line)  # keep the header

            # Add the new formatted nodes (8 per line)
            for i in range(0, len(his_nodes), 8):
                row = "".join(f"{n:10d}" for n in his_nodes[i:i+8])
                new_lines.append(row + "\n")

            in_nodes_section = True  # activate old lines skip mode
            continue

        # If we are in the old nodes section, skip until the next non-nodes line
        if in_nodes_section:
            if stripped.startswith("*") or (stripped.startswith("$#") and not stripped.startswith("$#   nodes")):
                in_nodes_section = False
                new_lines.append(line)  # add this line to mark the end of the section
            else:
                continue  # skip the old node lines
        else:
            new_lines.append(line)

    # save the modified ep_settings.k
    with open(ep_path, "w") as f:
        f.writelines(new_lines)

    print(f"✅ Successful modification : {len(his_nodes)} nodes injected, old nodes replaced.")
    return True


def modify_part_variable(file_path, part_name, variable_name, new_value):
    """
    Modifies the value of a specific variable for a given *PART section in an LS-DYNA .k file. It can be used in beam_networks.k files

    :param file_path: Path to the .k file
    :param part_name: Exact name of the part (heading) after *PART
    :param variable_name: Name of the variable exactly as written in the header line ($#)
    :param new_value: New value (int or float)
    """
    # Read the file
    with open(file_path, 'r') as f:
        lines = f.readlines()

    # Locate the part section
    part_line = None
    for i in range(len(lines)):
        if lines[i].strip().upper() == f"$$ {part_name} $$".upper():
            part_line = i
            break

    if part_line is None:
        print(f"❌ Part '{part_name}' not found.")
        return

    # Search for the variable in the block after the part heading
    variable_line = None
    value_index = None
    for j in range(part_line + 1, len(lines)):
        if lines[j].startswith("$#"):  # header line
            fields = lines[j][3:].split()
            if variable_name in fields:
                value_index = fields.index(variable_name)
                variable_line = j + 1
                break
        elif lines[j].strip().startswith("$$") and j != part_line:
            break  # Reached another part block before finding the variable

    if variable_line is None or value_index is None:
        print(f"❌ Variable '{variable_name}' not found in part '{part_name}'.")
        return
    
    if variable_name=='pmjres':
        value_index+=1

    # Modify the value while preserving the fixed 10-character field format
    data_line = lines[variable_line]
    columns = [data_line[i:i+10] for i in range(0, len(data_line.rstrip('\n')), 10)]

    if len(columns) > value_index:
        if isinstance(new_value, int):
            columns[value_index] = f"{new_value:10d}"
        elif isinstance(new_value, float):
            columns[value_index] = f"{new_value:10.6f}"
        else:
            print(f"⚠️ Unsupported value type: {type(new_value)}")
            return

        lines[variable_line] = ''.join(columns) + '\n'

        # Write changes back to file
        with open(file_path, 'w') as f:
            f.writelines(lines)

        print(f"✅ Variable '{variable_name}' updated for part '{part_name}'.")
    else:
        print(f"⚠️ Line {variable_line+1} does not have enough columns for index {value_index}.")


def set_endtim_in_main(main_k_path: str, new_endtim: float = 600.0) -> bool:
    """
    Modifies the endtim value in the *CONTROL_TERMINATION section of main.k.
    - main_k_path: path to main.k (str)
    - new_endtim: new value (e.g., 600.0)
    Returns True if modified, False otherwise.
    """
    if not os.path.exists(main_k_path):
        print(f"❌ missing file : {main_k_path}")
        return False

    # save backup
    backup = main_k_path + ".bak"
    shutil.copyfile(main_k_path, backup)
    print(f"💾 Backup copy created : {backup}")

    with open(main_k_path, "r", encoding="utf-8") as f:
        lines = f.readlines()

    n = len(lines)
    # find the *CONTROL_TERMINATION section
    ctrl_idx = None
    for i, L in enumerate(lines):
        if L.strip().upper().startswith("*CONTROL_TERMINATION"):
            ctrl_idx = i
            break
    if ctrl_idx is None:
        print("❌ *CONTROL_TERMINATION not found in file.")
        return False

    # find the header line ($# ...) that follows, then the next data line
    j = ctrl_idx + 1
    while j < n and not lines[j].strip().startswith("$#"):
        j += 1
    if j >= n:
        print("❌ Header line '$#' for CONTROL_TERMINATION not found.")
        return False

    data_idx = j + 1
    # skip empty lines or comments ($#) if necessary
    while data_idx < n and (lines[data_idx].strip() == "" or lines[data_idx].lstrip().startswith("$#")):
        data_idx += 1
    if data_idx >= n:
        print("❌ Data line for CONTROL_TERMINATION not found.")
        return False

    # keep the original line (for debug) and replace it by modifying only the first column
    orig = lines[data_idx].rstrip("\n")

    # adapt to the fixed 10-character width columns
    width = 10
    pad_len = ((len(orig) + width - 1) // width) * width
    pad_line = orig.ljust(pad_len)
    cols = [pad_line[k:k+width] for k in range(0, pad_len, width)]

    # replace the first column with the new value (format: 1 decimal, width 10)
    cols[0] = f"{float(new_endtim):10.1f}"

    # reconstruct the line  
    new_line = "".join(cols).rstrip() + "\n"
    lines[data_idx] = new_line

    # write the modified file
    with open(main_k_path, "w", encoding="utf-8") as f:
        f.writelines(lines)

    print(f"✅ endtime changed : {orig!r} -> {new_line.strip()!r}")
    return True


def replace_mat_blocks_preserve_titles(material_file: str):
    """
    Replace:
      - blocks *EM_MAT_003 (ventricles/septum)
      - blocks *EM_MAT_001 corresponding to the atria
    with adapted blocks *EM_MAT_005, keeping the mid and all titles.
    The other *EM_MAT_001 blocks (aorta, pulmonary artery, etc.) are retained.
    """
    if not os.path.exists(material_file):
        print(f"❌ Missing file: {material_file}")
        return False

    backup_file = material_file + ".bak"
    shutil.copyfile(material_file, backup_file)
    print(f"💾 Backup copy created: {backup_file}")

    with open(material_file, "r") as f:
        lines = f.readlines()

    new_lines = []
    i = 0
    n = len(lines)
    current_section = ""  # to detect atrium vs ventricles/septum

    while i < n:
        line = lines[i]
        stripped = line.strip()

        # Detect the section title
        if stripped.startswith("$$"):
            current_section = stripped.lower()
            new_lines.append(line)
            i += 1
            continue

        # DDetect the blocks to replace
        if (stripped.startswith("*EM_MAT_003") or
            (stripped.startswith("*EM_MAT_001") and "atrium" in current_section)):

            # retrieve the original mid (first integer value in the following lines)
            j = i + 1
            mid = None
            while j < n and mid is None:
                tokens = lines[j].split()
                for t in tokens:
                    if t.isdigit():
                        mid = int(t)
                        break
                j += 1

            if mid is None:
                print(f"⚠️ Impossible de trouver mid pour la section {current_section}")
                mid = 0

            # choose the corresponding EM_MAT_005
            if "atrium" in current_section:
                # block atrium
                new_block = f"""*EM_MAT_005
$#     mid     mtype   sigma11   sigma22   sigma33      beta        cm
{mid:10d}         2       1.2       0.6       0.3     140.0      0.01
$# sigma12   sigma13   sigma21   sigma23   sigma31   sigma32       

$#                     sigma11   sigma22   sigma33  
                          0.17      0.08      0.08

$#    aopt        xp        yp        zp        a1        a2        a3      macf
         2                                     0.0       0.0       1.0         1
$#      v1        v2        v3        d1        d2        d3
                                     0.0      -1.0       0.0
"""
            else:
                # block ventricule / septum
                new_block = f"""*EM_MAT_005
$#     mid     mtype   sigma11   sigma22   sigma33      beta        cm
{mid:10d}         2       0.7      0.35      0.18     140.0      0.01
$# sigma12   sigma13   sigma21   sigma23   sigma31   sigma32       

$#                     sigma11   sigma22   sigma33  
                          0.17      0.08      0.08

$#    aopt        xp        yp        zp        a1        a2        a3      macf
         2                                     0.0       0.0       1.0         1
$#      v1        v2        v3        d1        d2        d3
                                     0.0      -1.0       0.0
"""

            new_lines.append(new_block)

            # skip the old block until the next *EM_MAT_ block or end of file
            i += 1
            while i < n and not lines[i].strip().startswith("*EM_MAT_") and not lines[i].strip().startswith("$$"):
                i += 1
            continue

        new_lines.append(line)
        i += 1

    # write the modified material.k
    with open(material_file, "w") as f:
        f.writelines(new_lines)

    print("✅ All targeted blocks have been successfully replaced, other blocks are preserved.")
    return True


