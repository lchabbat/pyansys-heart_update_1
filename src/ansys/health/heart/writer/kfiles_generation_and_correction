def fmt_coord(value: float) -> str:
    """
    Returns a coordinate formatted to EXACTLY 9 characters,
    truncating decimals if necessary.
    The - sign counts as one of the 9 characters.
    No rounding: direct truncation.
    """
    s = f"{value}"

    # If already <= 9 characters → pad right
    if len(s) <= 9:
        return s.rjust(9)

    # If too long → truncate correctly
    if "." in s:
        before, after = s.split(".")

        # Max number of possible decimals
        max_after = 9 - len(before) - 1  # -1 for the point

        if max_after <= 0:
            # Extreme case: integer too long → cut
            return s[:9]

        truncated = before + "." + after[:max_after]
        return truncated.rjust(9)
    else:
        # Extreme case: integer too long
        return s[:9]


def update_em_point_set_strict(ep_settings_path: str,
                               new_coords: np.ndarray,
                               output_path: str = None,
                               start_pid: int = 0,
                               make_backup: bool = True):
    """
    Updates ONLY the electrode lines of the *EM_POINT_SET block,
    keeping everything else strictly unchanged.
    Coordinates are formatted to 9 characters (including sign).
    """
    ep_path = Path(ep_settings_path)
    if output_path is None:
        output_path = ep_settings_path

    if make_backup:
        copyfile(ep_settings_path, ep_settings_path + ".bak")

    with open(ep_settings_path, "r", encoding="utf-8") as f:
        lines = f.readlines()

    # --- search for *EM_POINT_SET keyword ---
    start_block = None
    for i, line in enumerate(lines):
        if line.strip().upper() == "*EM_POINT_SET":
            start_block = i
            break
    if start_block is None:
        raise RuntimeError("Bloc *EM_POINT_SET introuvable.")

    # search for the header line contaning the pid
    pid_header = "$#     pid         x         y         z       pos"
    pid_header_idx = None
    for j in range(start_block, len(lines)):
        if lines[j].strip() == pid_header:
            pid_header_idx = j
            break

    if pid_header_idx is None:
        raise RuntimeError("En-tête pid/x/y/z/pos introuvable.")


    coord_start = pid_header_idx + 1

    coord_end = coord_start
    while coord_end < len(lines) and not lines[coord_end].lstrip().startswith("*"):
        coord_end += 1

    # new lines of electrodes
    new_coord_lines = []
    pid = start_pid

    for (x, y, z) in new_coords:
        line = (
            f"{pid:10d}"
            f"{fmt_coord(x):>10}"
            f"{fmt_coord(y):>10}"
            f"{fmt_coord(z):>10}\n"
        )
        new_coord_lines.append(line)
        pid += 1

    # write the updated file
    updated = []
    updated.extend(lines[:coord_start])       # everything before the coordinates
    updated.extend(new_coord_lines)          # new coordinates
    updated.extend(lines[coord_end:])        # everything after

    with open(output_path, "w", encoding="utf-8") as f:
        f.writelines(updated)

    print(f"✔ File written: {output_path}")
    if make_backup:
        print(f"✔ Backup created: {ep_settings_path}.bak")





