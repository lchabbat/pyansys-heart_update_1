    MT_axis = (MR - TR)/np.linalg.norm(MR - TR)
    rot_MT = R.from_rotvec( np.radians(angle_mitral_tricuspide) * MT_axis)
    electrodes_MT = rot_MT.apply(electrodes_AT - MR) + MR
