    Rodero_apex = np.array([108,15,12])
    Rodero_tricuspide = np.array([42,49,47])
    Rodero_mitral  = np.array([78,78,62])
    Rodero_V_pulm = np.array([73, 42, 105])
    Rodero_centroid = np.array([67,53,62])


    P_Hans=np.array([Hans_apex, Hans_tricuspide, Hans_mitral,  Hans_V_pulm])
    P_Model= np.array([Rodero_apex, Rodero_tricuspide, Rodero_mitral, Rodero_V_pulm])

    AR, TR, MR, RP = Rodero_apex, Rodero_tricuspide, Rodero_mitral, Rodero_V_pulm

    #Translation
    T = P_Model[0] - P_Hans[0]
    T[1]=T[1]+0
    P_Hans_T = P_Hans + T

    #R1
    AH, TH, MH = P_Hans_T[0], P_Hans_T[1], P_Hans_T[2]
    VT_Hans = TH - AH
    VT_Model = TR - AR
    normal_R1 = np.cross(VT_Model, VT_Hans)
    angle_deg_R1 = np.degrees(-np.arccos(np.dot(VT_Hans, VT_Model) / (np.linalg.norm(VT_Model) * np.linalg.norm(VT_Hans))))
    axis_R1 = normal_R1 / np.linalg.norm(normal_R1)
    rot_R1 = R.from_rotvec( np.radians(angle_deg_R1) * axis_R1)
